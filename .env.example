# Postgres connection (Neon via Vercel Marketplace). Omit locally to use the embedded PGlite DB in ./.data
DATABASE_URL=

# First admin account — created automatically on first login when the admin_users table is empty
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Random 32+ byte secret for signing admin session cookies (required in production)
SESSION_SECRET=

# Vercel Blob token for news image uploads (auto-set when Blob is connected to the Vercel project)
BLOB_READ_WRITE_TOKEN=

# Optional: POST contact-form submissions as JSON to this URL (e.g. Slack/Zapier/email relay)
CONTACT_WEBHOOK_URL=

# Canonical site URL used for metadata
SITE_URL=https://seats-inc.com

# Optional: forward contact-form messages to Web3Forms email (the live site uses this service)
WEB3FORMS_ACCESS_KEY=
