# Cloudflare credentials for `npm run cf:deploy`.
# Copy this file to `.env.deploy` and fill in CLOUDFLARE_API_TOKEN — that file is
# gitignored and never committed.
#
# Create the token at https://dash.cloudflare.com -> My Profile -> API Tokens ->
# "Create Token" -> "Edit Cloudflare Workers" template, scoped to this account
# (agent.akaramedia@gmail.com). Using an API token instead of `wrangler login`
# means this project's deploys never get logged out by switching accounts for
# another project (e.g. BOSBA Premium Foods, which lives on a different account).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=84b7a80ce2a65a1bbf346ae32f137750
