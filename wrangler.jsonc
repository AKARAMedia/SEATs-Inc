{
  "$schema": "node_modules/wrangler/config-schema.json",
  // worker/index.mjs wraps .open-next/worker.js to pick the English or Japanese static page by cookie
  "main": "worker/index.mjs",
  "name": "seats-inc",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Keeps the Worker bundle smaller (size limits are on the compressed upload)
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // The build puts every prerendered public page (and /uploads/ images) in this directory, see
    // scripts/export-static.ts. Files under /_next, /media and /jp are served by Cloudflare
    // *without running the Worker* (free, no CPU limit). Everything else runs worker/index.mjs first:
    // English and Japanese share one URL, so the Worker picks the page file from the language cookie
    // (a plain asset lookup, no rendering). Each page view therefore counts as one Worker request.
    // /uploads/* also runs the Worker (one cheap asset lookup per image): an excluded path that has no
    // static file is a plain 404 and never reaches the Worker, so an image uploaded since the last deploy
    // would be broken in the admin until the next rebuild. The Worker falls back to the database for those.
    "run_worker_first": ["/*", "!/_next/*", "!/media/*", "!/jp/*", "!/favicon.ico", "!/icon.png"],
  },
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "seats-inc",
    },
  ],
  "images": {
    // next/image optimization, see https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES",
  },
  "kv_namespaces": [
    {
      // Short-TTL cache for the public /api/jobs feed (polled very frequently by other sites). The
      // Workers Cache API (caches.default) is scoped per colo/tier and gave inconsistent hits across
      // the colos real traffic was landing on; KV is globally readable so a value written by one
      // request is visible to the next request anywhere, not just nearby ones.
      "binding": "JOBS_CACHE",
      "id": "7ef304e0622b424592453914879eaab2",
    },
  ],
  // Keep the *.workers.dev address for testing alongside the real domain
  "workers_dev": true,
  // Custom Domains: Cloudflare creates the DNS records and certificates for these hostnames
  "routes": [
    { "pattern": "seats-inc.com", "custom_domain": true },
    { "pattern": "www.seats-inc.com", "custom_domain": true },
  ],
  "vars": {
    "SITE_URL": "https://seats-inc.com",
    // Public by design (Web3Forms access keys are meant to be embedded in client-side form HTML,
    // like a Stripe publishable key) — delivers Contact form submissions to hr-recruiting@seats-inc.com.
    // Recovered from the original site's exported HTML (content-export/pages/en/contact.html).
    "WEB3FORMS_ACCESS_KEY": "64ae37f2-b95c-4ab6-89b2-83a266a2882b",
  },
  // Secrets (wrangler secret put <NAME>): DATABASE_URL, SESSION_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD,
  // and optionally RESEND_API_KEY, EMAIL_FROM, CONTACT_WEBHOOK_URL
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
